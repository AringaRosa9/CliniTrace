APP_ENV=production
IDENTITY_PROVIDER=oidc
EXTRACTION_PROVIDER=disabled
ALLOW_SYNTHETIC_MOCK=false
TERMINOLOGY_VERSION=unmapped-1.0.0
PUBLIC_ORIGIN=https://clinical.example.invalid
# Inject independent secrets in protected files at deployment; chmod 600.
# API login must be member of bljgh_api only; worker login of bljgh_worker only.
DATABASE_URL=postgresql+psycopg://clinical_api:REPLACE@db.internal/clinical?sslmode=verify-full
REDIS_URL=rediss://:REPLACE@redis.internal:6379/0
S3_ENDPOINT_URL=https://objects.example.invalid
S3_BUCKET=clinical-documents
S3_ACCESS_KEY=REPLACE
S3_SECRET_KEY=REPLACE
SESSION_SECRET=REPLACE
METRICS_TOKEN=REPLACE
OIDC_ISSUER=https://identity.example.invalid
OIDC_CLIENT_ID=REPLACE
OIDC_CLIENT_SECRET=REPLACE
OIDC_AUTHORIZATION_URL=https://identity.example.invalid/authorize
OIDC_TOKEN_URL=https://identity.example.invalid/token
OIDC_JWKS_URL=https://identity.example.invalid/jwks
OCR_PROVIDER=tesseract
OCR_LANGUAGE=chi_sim+eng
MODEL_BUDGET_CNY=0
MAINTENANCE_MODE=false
