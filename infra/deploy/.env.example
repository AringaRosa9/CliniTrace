# Compose substitutions. Resolve digests after build + registry scan; never use latest.
BACKEND_IMAGE=registry.example.invalid/clinical/backend@sha256:REPLACE
FRONTEND_IMAGE=registry.example.invalid/clinical/frontend@sha256:REPLACE
GATEWAY_IMAGE=nginx@sha256:REPLACE
RUNTIME_ENV_FILE=/secure/clinical/api.env
WORKER_ENV_FILE=/secure/clinical/worker.env
