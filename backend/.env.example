APP_ENV=development
IDENTITY_PROVIDER=synthetic
EXTRACTION_PROVIDER=disabled
ALLOW_SYNTHETIC_MOCK=false
DATABASE_URL=postgresql+psycopg://bljgh:local-only@127.0.0.1:25432/bljgh
REDIS_URL=redis://127.0.0.1:26379/0
S3_ENDPOINT_URL=http://127.0.0.1:59000
S3_ACCESS_KEY=local-bljgh
S3_SECRET_KEY=local-only-change-me
MAX_UPLOAD_BYTES=20971520
MAX_DOCUMENT_PAGES=100
MAX_IMAGE_PIXELS=40000000
TASK_TIMEOUT_SECONDS=180
WORKER_CONCURRENCY=2
MAX_ATTEMPTS=3
MODEL_BUDGET_CNY=0

# Explicit local setup: choose a development access code before login.
SYNTHETIC_ACCESS_CODE=
SESSION_SECRET=development-only-session-secret-change-before-production
SESSION_SECONDS=3600
PUBLIC_ORIGIN=http://127.0.0.1:13000
DATABASE_ROLE=bljgh_api
WORKER_DATABASE_ROLE=bljgh_worker
S3_BUCKET=clinical-documents
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_JWKS_URL=

# S2: opt in explicitly. Synthetic grammar accepts only SYNTHETIC-S2 fixtures.
# EXTRACTION_PROVIDER=synthetic
# ALLOW_SYNTHETIC_MOCK=true
OCR_PROVIDER=disabled
OCR_LANGUAGE=chi_sim+eng
OCR_TIMEOUT_SECONDS=30
TERMINOLOGY_VERSION=unmapped-1.0.0
# Approved zero-charge schema gateway only. See docs/operations/s2.md.
EXTRACTION_GATEWAY_URL=
EXTRACTION_GATEWAY_TOKEN=
EXTRACTION_AUTHORIZATION=
EXTRACTION_MODEL=
EXTRACTION_TIMEOUT_SECONDS=30
EXTRACTION_MAX_CHARS=60000
EXTRACTION_MAX_OUTPUT_BYTES=2000000
EXTRACTION_MAX_REPAIRS=1
EXTRACTION_REQUESTS_PER_MINUTE=10
EXTRACTION_MAX_INFLIGHT=2
